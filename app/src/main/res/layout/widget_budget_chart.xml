<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_budget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@drawable/bg_widget_container"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_chart_image"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:contentDescription="預算圖表" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本月預算概覽"
            android:textSize="12sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/widget_percent_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2196F3" />

        <TextView
            android:id="@+id/widget_spent_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0 / $0"
            android:textSize="12sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/widget_remaining_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剩餘 $0"
            android:textSize="12sp"
            android:textColor="#4CAF50"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
